{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "dist/electo/legislation.json",
 "description": "{note, sessions{id:name}, items[12-tuple], checked}",
 "x-area": "export_bundle",
 "x-writer": "codeacts.export_legislation",
 "x-readers": "Electo acts.json",
 "x-version": "2.3",
 "x-documented-in": "docstring of export_legislation only",
 "x-observed": "not observed; from code",
 "x-issues": [],
 "type": "object",
 "properties": {
  "note": {
   "type": "string"
  },
  "sessions": {
   "type": "object",
   "description": "session id -> name"
  },
  "checked": {
   "type": "string"
  },
  "items": {
   "type": "array",
   "items": {
    "type": "array",
    "description": "[legislation_id, session, H|S, B|R, number:int, suffix, caption, status, status date MM/DD/YYYY, act/veto, sponsors, enacted 0/1]"
   }
  }
 },
 "required": [
  "note",
  "sessions",
  "checked"
 ]
}
